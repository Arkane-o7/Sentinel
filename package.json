{
  "name": "sentinel-agent-guard",
  "version": "0.1.0",
  "description": "Behavioral drift detection for autonomous AI agents. Built on jev-guard.",
  "type": "module",
  "bin": {
    "sentinel": "src/cli.js"
  },
  "exports": {
    ".": "./src/opencode.js",
    "./server": "./src/opencode.js",
    "./guard": "./src/guard.js",
    "./jev": "./src/jev.js"
  },
  "files": [
    "src",
    "extensions",
    "hooks",
    "plugin.json",
    "gemini-extension.json",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".agents",
    "assets/icon.svg",
    "assets/icon-512.png",
    "assets/works-with.svg",
    "dashboard",
    "demo",
    "docs",
    "LICENSE",
    "scripts",
    "evaluation",
    "NOTICE",
    "tsconfig.json",
    "eslint.config.js",
    "artifacts/dashboard.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:upstream": "node --test test/guard.test.js",
    "test:sentinel": "node --test test/sentinel.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts test dashboard",
    "build": "node scripts/build.js",
    "demo": "node src/cli.js demo",
    "dashboard": "node src/cli.js dashboard",
    "evaluate": "node scripts/evaluate.js",
    "record": "node scripts/record.js",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "test:browser": "node scripts/browser-check.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "keywords": [
    "jev",
    "typesafe",
    "prompt-injection",
    "security",
    "hooks",
    "claude-code",
    "codex",
    "copilot",
    "gemini-cli",
    "cursor",
    "pi-package",
    "opencode-plugin",
    "acp"
  ],
  "author": "Sentinel contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/opencode.js",
  "contributors": [
    {
      "name": "leepokai",
      "url": "https://github.com/leepokai"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkane-o7/Sentinel.git"
  },
  "homepage": "https://github.com/Arkane-o7/Sentinel#readme",
  "bugs": {
    "url": "https://github.com/Arkane-o7/Sentinel/issues"
  }
}
